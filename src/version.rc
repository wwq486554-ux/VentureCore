#include <windows.h>

#include "Core/PlatformConfig.h"
#include "Core/PlatformVersion.h"

#define ID_VERSION 1

ID_VERSION VERSIONINFO
FILEVERSION VC_FILEVERSION
PRODUCTVERSION VC_FILEVERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef VC_PRERELEASE_SUFFIX
FILEFLAGS VS_FF_PRERELEASE
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", VC_PLATFORM_NAME "\0"
   VALUE "CompanyName", "The VentureCore Contributors\0"
   VALUE "LegalCopyright", "MIT License - Copyright (c) 2026 The VentureCore Contributors\0"
   VALUE "FileDescription", "VentureCore platform DLL for Command & Conquer: Yuri's Revenge\0"
   VALUE "FileVersion", VC_VERSION_DISPLAY "\0"
   VALUE "ProductVersion", VC_VERSION_DISPLAY "\0"
   VALUE "InternalName", VC_PLATFORM_NAME "\0"
   VALUE "OriginalFilename", VC_PLATFORM_DLL_NAME "\0"
   VALUE "PlatformBuildType", VC_BUILD_TYPE "\0"
   VALUE "YrppCommit", VC_YRPP_PIN "\0"
#ifdef STR_GIT_COMMIT
   VALUE "GitCommit", STR_GIT_COMMIT "\0"
#endif
#ifdef STR_GIT_REF
   VALUE "GitRef", STR_GIT_REF "\0"
#endif
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
